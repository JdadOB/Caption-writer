# Database — use a local SQLite file for development, or a Postgres URL in production
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Resend (email notifications) — optional, leave empty to disable emails
RESEND_API_KEY=""
EMAIL_FROM="Creator Dashboard <notify@example.com>"

# Admin bootstrap — used by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"
